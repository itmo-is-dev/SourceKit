    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\samples\analyzers\SourceKit.Analyzers.Collections.Samples\**\*.cs"
                 Exclude="..\..\samples\analyzers\SourceKit.Analyzers.Collections.Samples\obj\**"
                 LinkBase="SourceKit.Analyzers.Collections.Samples\"
