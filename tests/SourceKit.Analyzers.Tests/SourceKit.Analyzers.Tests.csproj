        <Content Include="..\..\samples\analyzers\SourceKit.Analyzers.Nullable.Samples\**\*.cs"
                 Exclude="..\..\samples\analyzers\SourceKit.Analyzers.Nullable.Samples\obj\**"
                 LinkBase="SourceKit.Analyzers.Nullable.Samples\"
