        <Content Include="..\..\samples\analyzers\SourceKit.Analyzers.Properties.Samples\**\*.cs"
                 Exclude="..\..\samples\analyzers\SourceKit.Analyzers.Properties.Samples\obj\**"
                 LinkBase="SourceKit.Analyzers.Properties.Samples\"
