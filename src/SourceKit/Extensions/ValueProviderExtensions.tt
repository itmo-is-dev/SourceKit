    public static void RegisterSourceOutput<<#= genericParameters #>>(
        this IncrementalGeneratorInitializationContext context,
        IncrementalValueProvider<<#= genericParameters #>> provider,
        Action<SourceProductionContext, <#= genericParameters #>> action)
    {
        context.RegisterSourceOutput(
            (IncrementalValueProvider<<#= tupleGenericParameters #>>)provider,
            (ctx, tuple) => action(ctx, <#= ExtractElements("tuple", parameterCount) #>));
    }

